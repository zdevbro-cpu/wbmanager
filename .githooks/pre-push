#!/bin/sh
# 강제 푸시(비-빨리감기) 차단.
# 원격 커밋이 내 커밋의 조상이 아니면 = 원격 이력을 덮어쓰는 푸시다. 무조건 막는다.
# 2026-08-05 사무실→원격 강제 푸시로 전날 저녁 커밋 24개가 원격에서 지워진 사고 재발 방지.

zero=$(git hash-object --stdin </dev/null | tr '[0-9a-f]' '0')
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	# 브랜치 삭제
	if [ "$local_sha" = "$zero" ]; then
		echo "차단: 원격 브랜치 삭제는 이 훅에서 막습니다 ($remote_ref)" >&2
		status=1
		continue
	fi

	# 원격에 없던 새 브랜치는 덮어쓸 이력이 없으므로 허용
	[ "$remote_sha" = "$zero" ] && continue

	# 원격 커밋이 내 이력에 포함돼 있지 않다 = 덮어쓰기
	if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
		echo "" >&2
		echo "=========================================================" >&2
		echo " 푸시 차단 — 원격 이력을 덮어쓰려 하고 있습니다" >&2
		echo "" >&2
		echo "   대상   : $remote_ref" >&2
		echo "   원격   : $(git log -1 --format='%h %s' "$remote_sha" 2>/dev/null || echo "$remote_sha")" >&2
		echo "   내 것  : $(git log -1 --format='%h %s' "$local_sha")" >&2
		echo "" >&2
		echo " 원격에 내가 받지 않은 커밋이 있습니다." >&2
		echo " 강제 푸시하면 그 커밋들이 사라집니다." >&2
		echo "" >&2
		echo " 이렇게 하세요:" >&2
		echo "   git fetch origin" >&2
		echo "   git log --oneline HEAD..origin/$(echo "$remote_ref" | sed 's|refs/heads/||')" >&2
		echo "   내용 확인 후 병합하거나, 어떻게 할지 결정하세요." >&2
		echo "=========================================================" >&2
		echo "" >&2
		status=1
	fi
done

exit $status

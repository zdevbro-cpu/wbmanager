// wbmanager DB 스키마 초안
// 근거: data/프로젝트정산_ERD.drawio, data/원방_업무흐름도_상세.drawio, data/원방_데이터흐름도_DFD.drawio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── 사용자 인증/승인 ──────────────────────

// Firebase Authentication 계정과 매핑되는 내부 사용자. 가입 후 관리자 승인 전까지는 pending 상태.
model AppUser {
  id          String   @id @default(uuid())
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique
  name        String?
  role        String   @default("worker") @map("role") // worker(업무 담당자) | admin(관리자)
  status      String   @default("pending") @map("status") // pending | approved | rejected
  createdAt   DateTime @default(now()) @map("created_at")
  approvedAt  DateTime? @map("approved_at")

  @@map("app_user")
}

// ── 기준정보 ──────────────────────────────

// 거래처 마스터(매입처/매각처/자회사/폐기물업체 등) — 드롭다운 선택 입력의 기준
model Vendor {
  id          String   @id @default(uuid())
  name        String   @map("name")
  vendorType  String?  @map("vendor_type") // 매입처/매각처/자회사/폐기물업체 등
  isTemporary Boolean  @default(false) @map("is_temporary") // 마스터 미존재 시 임시 등록 여부(추후 승격/매핑)
  createdAt   DateTime @default(now()) @map("created_at")

  projects       Project[]
  outboundSales  OutboundSale[]
  wasteOutbounds WasteOutbound[]

  @@map("vendor")
}

model ItemMaster {
  id          String   @id @default(uuid())
  itemCode    String   @unique @map("item_code")
  category    String   @map("category")       // 대분류: FE, AL, STS, CU, 부품, 중고설비 등
  subCategory String?  @map("sub_category")
  itemName    String   @map("item_name")
  basePrice   Decimal? @map("base_price") @db.Decimal(14, 2)
  isTemporary Boolean  @default(false) @map("is_temporary")
  createdAt   DateTime @default(now()) @map("created_at")

  sortings        Sorting[] @relation("SortingItem")
  sourceSortings  Sorting[] @relation("SortingSourceItem")
  inventoryLedger InventoryLedger[]
  inbounds        Inbound[]
  wasteInbounds   WasteInbound[]
  outboundSales   OutboundSale[]
  wasteOutbounds  WasteOutbound[]
  priceHistory    ItemPriceHistory[]

  @@map("item_master")
}

// 품목 추정단가 이력 — 재고평가에 사용. projectId가 null이면 전체 적용, 값이 있으면 해당 차수만 적용. (S-YZTHIZ)
model ItemPriceHistory {
  id            String    @id @default(uuid())
  itemCode      String    @map("item_code")
  item          ItemMaster @relation(fields: [itemCode], references: [itemCode])
  projectId     String?   @map("project_id")
  project       Project?  @relation(fields: [projectId], references: [id])
  price         Decimal   @map("price") @db.Decimal(14, 2)
  effectiveDate DateTime  @map("effective_date")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("item_price_history")
}

model Project {
  id            String    @id @default(uuid())
  roundName     String    @map("round_name")      // 예: 26-1차
  buyerId       String?   @map("buyer_id")         // 매입처(거래처 마스터)
  buyer         Vendor?   @relation(fields: [buyerId], references: [id])
  purchasePrice Decimal?  @map("purchase_price") @db.Decimal(14, 2)
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  status        String    @default("진행") @map("status") // 진행/완료
  createdAt     DateTime  @default(now()) @map("created_at")

  inbounds          Inbound[]
  wasteInbounds     WasteInbound[]
  sortings          Sorting[]
  inventoryLedger   InventoryLedger[]
  outboundSales     OutboundSale[]
  wasteOutbounds    WasteOutbound[]
  transports        Transport[]
  labors            Labor[]
  workerAttendances WorkerAttendance[]
  priceHistory      ItemPriceHistory[]

  @@map("project")
}

model Worker {
  id         String   @id @default(uuid())
  affiliation String? @map("affiliation") // 소속: 본사/직영/겨를
  name       String   @map("name")
  dailyWage  Decimal? @map("daily_wage") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  attendances WorkerAttendance[]

  @@map("worker")
}

// ── 물량 트랜잭션 ──────────────────────────

// 현장 스크랩 입고(반입) — 원본 대조: data/.../원방_현장 스크랩 입고 현황_Sample.xlsx `스크랩입고량` 시트,
// ecount 구매입력 화면(3. 입고(구매)입력.png)
model Inbound {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id])
  inboundDate   DateTime @map("inbound_date")     // 상차일
  loadingPoint  String?  @map("loading_point")
  unloadingPoint String? @map("unloading_point")  // 하차지: 원방/세화철강/선진알앤디 등
  vehicleNo     String?  @map("vehicle_no")
  driverName    String?  @map("driver_name")      // 운전자
  driverPhone   String?  @map("driver_phone")     // 연락처
  vehicleType   String?  @map("vehicle_type")     // 차종: 집게차/카고/암롤트럭/방통차 등
  itemCode      String?  @map("item_code")        // 제품명(품목 마스터)
  item          ItemMaster? @relation(fields: [itemCode], references: [itemCode])
  itemName      String?  @map("item_name")        // 품목마스터 미매칭 시 표시용
  grossWeight   Decimal  @map("gross_weight") @db.Decimal(12, 3)  // 총중량
  tareWeight    Decimal  @map("tare_weight") @db.Decimal(12, 3)   // 공차중량
  lossWeight    Decimal? @map("loss_weight") @db.Decimal(12, 3)   // 감량
  netWeight     Decimal  @map("net_weight") @db.Decimal(12, 3)    // 입고량 = 총중량 - 공차중량 - 감량
  stockWeight   Decimal? @map("stock_weight") @db.Decimal(12, 3)  // 재고반영중량(ecount 필수) — 기본값은 입고량과 동기화
  storageZone   String?  @map("storage_zone")
  memo          String?  @map("memo")             // 비고
  createdAt     DateTime @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")      // 소프트 삭제

  attachments Attachment[]

  @@map("inbound")
}

// 현장 폐기물 입고 — 원본 대조: 위 샘플 엑셀 `폐기물 입고` 시트.
// 스크랩 입고와 컬럼 구성이 동일하고 인수일/인계일/올바로/배출자가 추가된다.
model WasteInbound {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id])
  receiveDate    DateTime @map("receive_date")      // 인수일
  handoverDate   DateTime? @map("handover_date")    // 인계일
  olbaroReported Boolean  @default(false) @map("olbaro_reported") // 올바로 신고 상태(O/X)
  dischargerName String?  @map("discharger_name")   // 배출자: 케이엠티엘에스/크로스특수/원방 등
  unloadingPoint String?  @map("unloading_point")   // 하차지: 투플러스/주원/도솔환경산업 등
  vehicleNo      String?  @map("vehicle_no")
  driverName     String?  @map("driver_name")
  driverPhone    String?  @map("driver_phone")
  vehicleType    String?  @map("vehicle_type")
  itemCode       String?  @map("item_code")         // 제품명(폐합성수지/폐판넬/폐콘크리트 등)
  item           ItemMaster? @relation(fields: [itemCode], references: [itemCode])
  itemName       String?  @map("item_name")
  grossWeight    Decimal  @map("gross_weight") @db.Decimal(12, 3)
  tareWeight     Decimal  @map("tare_weight") @db.Decimal(12, 3)
  lossWeight     Decimal? @map("loss_weight") @db.Decimal(12, 3)
  netWeight      Decimal  @map("net_weight") @db.Decimal(12, 3) // 입고량 = 총중량 - 공차중량 - 감량
  memo           String?  @map("memo")
  createdAt      DateTime @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")     // 소프트 삭제

  attachments Attachment[]

  @@map("waste_inbound")
}

// 선별은 재고를 늘리는 행위가 아니라 품목을 바꾸는 재분류다.
// 재고원장에는 원품목 OUT + 확정품목 IN(순증 0)으로 기록한다.
// 근거: 갑지의 재고량 = 입고량 - 출고량 (원방_거래처별 스크랩 출고 현황_Sample.xlsx 갑지 시트)
model Sorting {
  id             String   @id @default(uuid())
  projectId      String   @map("project_id")
  project        Project  @relation(fields: [projectId], references: [id])
  sourceItemCode String?  @map("source_item_code")  // 선별 전 품목(미지정 시 미분류)
  sourceItem     ItemMaster? @relation("SortingSourceItem", fields: [sourceItemCode], references: [itemCode])
  itemCode       String   @map("item_code")          // 선별 후 확정 품목
  item           ItemMaster @relation("SortingItem", fields: [itemCode], references: [itemCode])
  sortDate       DateTime @map("sort_date")
  sortWeight     Decimal  @map("sort_weight") @db.Decimal(12, 3)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("sorting")
}

model InventoryLedger {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id])
  itemCode   String   @map("item_code")
  item       ItemMaster @relation(fields: [itemCode], references: [itemCode])
  direction  String   @map("direction")   // IN(+) / OUT(-)
  weight     Decimal  @map("weight") @db.Decimal(12, 3)
  ledgerDate DateTime @map("ledger_date")
  refType    String?  @map("ref_type")    // inbound / outbound_sale / waste_outbound 등
  refId      String?  @map("ref_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("inventory_ledger")
}

// 스크랩 출고(매각) — 원본 대조: 원방_거래처별 스크랩 출고 현황_Sample.xlsx `스크랩출고량`/거래처별 시트,
// ecount 판매입력 화면(6. 판매입력.png)
model OutboundSale {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  project          Project  @relation(fields: [projectId], references: [id])
  itemCode         String   @map("item_code")
  item             ItemMaster @relation(fields: [itemCode], references: [itemCode])
  outboundDate     DateTime @map("outbound_date")   // 계량일
  buyerId          String?  @map("buyer_id")        // 거래처(매각처)
  buyer            Vendor?  @relation(fields: [buyerId], references: [id])
  loadingPoint     String?  @map("loading_point")   // 상차지: 원방 등
  vehicleType      String?  @map("vehicle_type")    // 차종
  vehicleNo        String?  @map("vehicle_no")
  driverName       String?  @map("driver_name")     // 운전자
  driverPhone      String?  @map("driver_phone")    // 연락처
  unitPrice        Decimal? @map("unit_price") @db.Decimal(12, 2)
  grossWeight      Decimal? @map("gross_weight") @db.Decimal(12, 3)
  tareWeight       Decimal? @map("tare_weight") @db.Decimal(12, 3)
  actualWeight     Decimal? @map("actual_weight") @db.Decimal(12, 3)   // 실중량 = 총중량 - 공차중량
  preLossWeight    Decimal? @map("pre_loss_weight") @db.Decimal(12, 3) // 거래처 감량 전 실중량
  lossWeight       Decimal? @map("loss_weight") @db.Decimal(12, 3) // 감량
  settledWeight    Decimal  @map("settled_weight") @db.Decimal(12, 3) // 정산중량 = gross - tare - loss
  stockWeight      Decimal? @map("stock_weight") @db.Decimal(12, 3)  // 재고반영중량(ecount 필수) — 기본값은 정산중량과 동기화
  amount           Decimal? @map("amount") @db.Decimal(14, 2)        // 공급가액 = 정산중량 × 단가
  vatAmount        Decimal? @map("vat_amount") @db.Decimal(14, 2)    // 부가세
  category         String?  @map("category")        // 구분: 출고/보류/기타
  isSubsidiary     Boolean  @default(false) @map("is_subsidiary")  // 자회사 출고 여부
  memo             String?  @map("memo")            // 비고(특이사항)
  taxInvoiceIssued Boolean  @default(false) @map("tax_invoice_issued")
  isPaid           Boolean  @default(false) @map("is_paid")
  paidDate         DateTime? @map("paid_date")      // 입금일
  createdAt        DateTime @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")      // 소프트 삭제

  attachments Attachment[]

  @@map("outbound_sale")
}

// 폐기물 반출 — 원본 대조: 원방_거래처별 스크랩 출고 현황_Sample.xlsx `폐기물출고량` 시트(헤더 4행)
// 및 거래처별 시트(주원(폐기물)/투플러스(폐판넬)/도솔환경(폐콘)/폐기물 기타업체)
model WasteOutbound {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id])
  outboundDate DateTime @map("outbound_date")            // 상차일
  buyerId      String?  @map("buyer_id")                 // 처리자(거래처명)
  buyer        Vendor?  @relation(fields: [buyerId], references: [id])
  itemCode     String?  @map("item_code")
  item         ItemMaster? @relation(fields: [itemCode], references: [itemCode])
  itemName     String?  @map("item_name") // 품목마스터 미매칭 시 표시용
  dischargerName  String?  @map("discharger_name")       // 배출자
  transporterName String?  @map("transporter_name")      // 운반자
  loadingPoint    String?  @map("loading_point")         // 상차지: 현장 / 원방 등
  vehicleType     String?  @map("vehicle_type")          // 차종
  vehicleNo       String?  @map("vehicle_no")
  driverName      String?  @map("driver_name")           // 운전자
  driverPhone     String?  @map("driver_phone")          // 연락처
  grossWeight     Decimal? @map("gross_weight") @db.Decimal(12, 3)   // 총중량
  tareWeight      Decimal? @map("tare_weight") @db.Decimal(12, 3)    // 공차중량
  actualWeight    Decimal? @map("actual_weight") @db.Decimal(12, 3)  // 실중량 = 총중량 - 공차중량
  preLossWeight   Decimal? @map("pre_loss_weight") @db.Decimal(12, 3) // 거래처 감량 전 실중량
  lossWeight      Decimal? @map("loss_weight") @db.Decimal(12, 3)    // 감량(계근차)
  weight       Decimal  @map("weight") @db.Decimal(12, 3)            // 정산 중량
  unitPrice       Decimal? @map("unit_price") @db.Decimal(12, 2)     // 단가
  cubicMeter      Decimal? @map("cubic_meter") @db.Decimal(10, 2)    // 루베 적용
  amount       Decimal? @map("amount") @db.Decimal(14, 2) // 지출 = 정산중량 × 단가
  category        String?  @map("category")               // 구분: 출고/이동
  memo            String?  @map("memo")                   // 비고
  isSubsidiary    Boolean  @default(false) @map("is_subsidiary") // 자회사 출고 여부
  transferDate    DateTime? @map("transfer_date")         // 이체일
  olbaroReported Boolean  @default(false) @map("olbaro_reported") // 올바로 신고 상태(O/X)
  handoverDate   DateTime? @map("handover_date") // 인계일
  olbaroMemo     String?  @map("olbaro_memo") // 기준업체량 등 메모
  createdAt    DateTime @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")   // 소프트 삭제

  attachments Attachment[]

  @@map("waste_outbound")
}

// ── 비용 트랜잭션 ──────────────────────────

model Transport {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  project       Project  @relation(fields: [projectId], references: [id])
  transportDate DateTime @map("transport_date")
  vehicleNo     String?  @map("vehicle_no")
  weight        Decimal? @map("weight") @db.Decimal(12, 3)
  vehicleType   String?  @map("vehicle_type")
  origin        String?  @map("origin")
  destination   String?  @map("destination")
  supplyAmount  Decimal? @map("supply_amount") @db.Decimal(14, 2)
  taxAmount     Decimal? @map("tax_amount") @db.Decimal(14, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("transport")
}

model Labor {
  id           String   @id @default(uuid())
  projectId    String   @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id])
  workDate     DateTime @map("work_date")
  totalManDays Decimal? @map("total_man_days") @db.Decimal(8, 3)
  laborCost    Decimal? @map("labor_cost") @db.Decimal(14, 2)
  mealCost     Decimal? @map("meal_cost") @db.Decimal(14, 2)
  toolCost     Decimal? @map("tool_cost") @db.Decimal(14, 2)
  fuelCost     Decimal? @map("fuel_cost") @db.Decimal(14, 2)
  suppliesCost Decimal? @map("supplies_cost") @db.Decimal(14, 2)
  totalAmount  Decimal? @map("total_amount") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("labor")
}

model WorkerAttendance {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id])
  workerId  String   @map("worker_id")
  worker    Worker   @relation(fields: [workerId], references: [id])
  workDate  DateTime @map("work_date")
  manDays   Decimal  @map("man_days") @db.Decimal(4, 3) // 0.125 단위
  createdAt DateTime @default(now()) @map("created_at")

  @@map("worker_attendance")
}

// ── 총무 (차량/중장비/어테치, 임직원/자격증) ──

model Vehicle {
  id            String   @id @default(uuid())
  vehicleNo     String   @unique @map("vehicle_no")
  vehicleType   String?  @map("vehicle_type") // 법인차량/중장비/어테치
  inspectionExpiry DateTime? @map("inspection_expiry")
  currentSite   String?  @map("current_site")
  createdAt     DateTime @default(now()) @map("created_at")

  movements   VehicleMovement[]
  maintenances VehicleMaintenance[]
  attachments Attachment[]   // 차량등록증/보험증서/검사증 등 차량 관련 문서

  @@map("vehicle")
}

model VehicleMovement {
  id          String   @id @default(uuid())
  vehicleId   String   @map("vehicle_id")
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  moveDate    DateTime @map("move_date")
  fromSite    String?  @map("from_site")
  toSite      String?  @map("to_site")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("vehicle_movement")
}

model VehicleMaintenance {
  id            String   @id @default(uuid())
  vehicleId     String   @map("vehicle_id")
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  maintenanceDate DateTime @map("maintenance_date")
  description   String?  @map("description")
  cost          Decimal? @map("cost") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  attachments Attachment[]

  @@map("vehicle_maintenance")
}

model Employee {
  id        String   @id @default(uuid())
  name      String   @map("name")
  phone     String?  @map("phone")        // 연락처 — 입출고 등록 시 운전자 선택하면 자동 채움
  position  String?  @map("position")
  department String? @map("department")
  hireDate  DateTime? @map("hire_date")
  createdAt DateTime @default(now()) @map("created_at")

  certifications EmployeeCertification[]
  trainings      EmployeeTraining[]

  @@map("employee")
}

model EmployeeCertification {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  certName     String    @map("cert_name")
  acquiredDate DateTime? @map("acquired_date")
  expiryDate   DateTime? @map("expiry_date")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("employee_certification")
}

model EmployeeTraining {
  id           String    @id @default(uuid())
  employeeId   String    @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id])
  trainingName String    @map("training_name")
  trainingType String?   @map("training_type")   // 의무 / 보수
  trainingDate DateTime? @map("training_date")   // 이수일
  nextDueDate  DateTime? @map("next_due_date")   // 다음 교육 예정일 — D-day 산출 기준
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("employee_training")
}

// ── 공통코드 ────────────────────────────────
// 배출자·운반자·상차지·차종 등 자유 텍스트로 입력되던 반복 값을 한 곳에서 관리한다.
// 값 하나짜리 목록만 담으며, 차량·임직원처럼 이력이 붙는 대상은 별도 마스터를 유지한다.
model CommonCode {
  id        String   @id @default(uuid())
  group     String   @map("group")      // 배출자 / 운반자 / 상차지 / 차종 ...
  label     String   @map("label")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([group, label])
  @@map("common_code")
}

// ── 파일/증빙 (Google Drive 참조) ────────────

model Attachment {
  id          String   @id @default(uuid())
  driveFileId String   @map("drive_file_id")
  fileName    String?  @map("file_name")
  fileType    String?  @map("file_type") // 계량증명서/현장사진/정비명세서/차량등록증/검사증 등
  webViewLink String?  @map("web_view_link")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  inboundId           String? @map("inbound_id")
  inbound             Inbound? @relation(fields: [inboundId], references: [id])
  wasteInboundId       String? @map("waste_inbound_id")
  wasteInbound         WasteInbound? @relation(fields: [wasteInboundId], references: [id])
  outboundSaleId       String? @map("outbound_sale_id")
  outboundSale         OutboundSale? @relation(fields: [outboundSaleId], references: [id])
  wasteOutboundId      String? @map("waste_outbound_id")
  wasteOutbound        WasteOutbound? @relation(fields: [wasteOutboundId], references: [id])
  vehicleMaintenanceId String? @map("vehicle_maintenance_id")
  vehicleMaintenance   VehicleMaintenance? @relation(fields: [vehicleMaintenanceId], references: [id])
  vehicleId            String? @map("vehicle_id")
  vehicle              Vehicle? @relation(fields: [vehicleId], references: [id])

  @@map("attachment")
}
